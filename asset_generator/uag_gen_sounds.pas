(*
 * Generator 'sounds': renders every section of sounds.ini (own synth
 * interpretations of the game sounds, see uag_sound) into
 * sounds/<name>.wav, the menu sounds into res/<name>.wav. The file names are
 * the ones of the original game, so the client needs no mapping.
 *
 * sounds.ini is compiled in (uag_sounds_ini.inc, generated by
 * tools/wav2ini --inc sounds.ini uag_sounds_ini.inc), so the generator works
 * without any data files.
 *
 * Every set gets a slightly different variant (style independent): pitch and
 * decay of the whole set and a little per sound, and its own noise.
 *)
Unit uag_gen_sounds;

{$MODE ObjFPC}{$H+}

Interface

Implementation

Uses SysUtils, uag_context, uag_output, uag_registry, uag_random, uag_sound;

Const
{$I uag_sounds_ini.inc}

  ResSounds: Array[0..1] Of String = ('menuexit', 'quitgame'); // go to res/, all others to sounds/

Var
  Book: TAGSoundBook = Nil;

Function SoundPath(Const Name: String): String;
Var
  i: Integer;
Begin
  For i := 0 To high(ResSounds) Do
    If SameText(ResSounds[i], Name) Then exit('res/' + Name + '.wav');
  result := 'sounds/' + Name + '.wav';
End;

Function ExpectedSounds(Ctx: TAGContext): Integer;
Begin
  result := Book.Count;
End;

Procedure GenerateSounds(Ctx: TAGContext; Output: TAGOutput);
Var
  area: TAGArea;
  setPitch, setDecay: Double;
  v: TAGSoundVariation;
  i: Integer;
  name: String;
Begin
  area := Ctx.Area('sounds');
  setPitch := area.Vary('pitch', 1, 0.02);
  setDecay := area.Vary('decay', 1, 0.07);
  For i := 0 To Book.Count - 1 Do Begin
    name := Book.Names[i];
    If Output.DryRun Then Begin // previews: nothing to show, only count
      Output.SaveData(SoundPath(name), Nil);
      Continue;
    End;
    // per sound: pitch +-1 %, decay +-3 % on top of the set values
    v.Pitch := setPitch * (1 + 0.01 * (2 * area.Rnd('pitch/' + name) - 1));
    v.Decay := setDecay * (1 + 0.03 * (2 * area.Rnd('decay/' + name) - 1));
    v.Seed := DeriveSeed(area.Seed, 'noise/' + name);
    Output.SaveData(SoundPath(name), AGRenderWav(Book.Parts[i], v));
  End;
End;

Initialization
  Book := TAGSoundBook.Create;
  Book.LoadFromLines(SoundsIni);
  If Book.Errors.Count > 0 Then
    Raise Exception.Create('uag_sounds_ini.inc: line not understood: ' + Book.Errors[0]);
  RegisterGenerator('sounds', 'Sound effects (sounds/*.wav, res/menuexit.wav, quitgame.wav)', @ExpectedSounds, @GenerateSounds);

Finalization
  Book.Free;

End.
