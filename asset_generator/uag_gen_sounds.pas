(*
 * Generator 'sounds': renders every section of sounds.ini (own synth
 * interpretations of the game sounds, see uag_sound) into
 * sounds/<name>.wav, the menu sounds into res/<name>.wav, and the menu music
 * of music.ini (res/mainmenu_sound.wav, join_sound.wav,
 * player_setup_sound.wav, draw.wav). The file names are the ones of the
 * original game, so the client needs no mapping.
 *
 * sounds.ini and music.ini are compiled in (uag_sounds_ini.inc,
 * uag_music_ini.inc, generated by tools/wav2ini --inc), so the generator
 * works without any data files.
 *
 * The style chooses the sound kit (flat, soft, pixel, retro, see uag_sound).
 * Every set gets its own variant on top: pitch, decay, brightness and noise
 * colour of the whole set and a little per sound, its own noise; the music
 * is transposed (+-2 semitones), a bit faster or slower and its pulse widths
 * differ. Music files with the same song and changes are rendered once.
 *
 * Spoken sounds exist per language: sounds.ini [name] is English (the
 * default), [name@de] German. Every spoken sound is written in every
 * language into a sub folder (sounds/en/<name>.wav, sounds/de/<name>.wav,
 * res/en/quitgame.wav, ...), the game takes the one of its language (see
 * SoundFile in units/uassetpath.pas). The plain file (sounds/<name>.wav) is
 * the language Ctx.Language (the default of the set, for games that do not
 * know the sub folders); a sound without a section in that language uses
 * [name]. The editor preview (DryRun with KeepData) only renders the plain
 * files, i.e. Ctx.Language.
 *
 * For the editor (DryRun with KeepData, see uag_output) the effects and the
 * music are separate areas: GenerateSoundEffects (area 'sounds') and
 * GenerateMusic (area 'music').
 *)
Unit uag_gen_sounds;

{$MODE ObjFPC}{$H+}

Interface

Uses SysUtils, uag_context, uag_output;

Type
  TAGSoundGroup = (sgExplosion, sgBomb, sgPowerup, sgFigure, sgVoice, sgHurry, sgWinner, sgMenu, sgMusic);

Procedure GenerateSoundEffects(Ctx: TAGContext; Output: TAGOutput); // sounds/*.wav, res/menuexit + quitgame
Procedure GenerateMusic(Ctx: TAGContext; Output: TAGOutput); // res/<music>.wav
Function SoundGroup(Const RelPath: String): TAGSoundGroup; // e.g. 'sounds/bomb_01.wav' -> sgExplosion
Function VoiceLanguages: TStringArray; // 'en' first, then the languages of sounds.ini ('de')
Function IsVoiceLanguage(Const Lang: String): Boolean;

Implementation

Uses Classes, uag_registry, uag_random, uag_sound;

Const
{$I uag_sounds_ini.inc}
{$I uag_music_ini.inc}

  ResSounds: Array[0..1] Of String = ('menuexit', 'quitgame'); // go to res/, all others to sounds/
  StyleKit: Array[TAGStyle] Of TAGSoundKit = (skFlat, skSoft, skPixel, skRetro);

Var
  Book: TAGSoundBook = Nil;
  Music: TAGMusicBook = Nil;

Function SoundPath(Const Name: String): String;
Var
  i: Integer;
Begin
  For i := 0 To high(ResSounds) Do
    If SameText(ResSounds[i], Name) Then exit('res/' + Name + '.wav');
  result := 'sounds/' + Name + '.wav';
End;

(* the file of the language Lang: sounds/<lang>/<name>.wav, res/<lang>/<name>.wav *)
Function LangSoundPath(Const Name, Lang: String): String;
Var
  p: String;
Begin
  p := SoundPath(Name);
  result := ExtractFilePath(p) + Lang + '/' + ExtractFileName(p);
End;

(* [name@lang] is a language variant of [name] *)
Function IsVariant(Const Section: String): Boolean;
Begin
  result := Pos('@', Section) > 0;
End;

(* [name] has language variants ([name@de], ...): a spoken sound *)
Function IsSpoken(Const Name: String): Boolean;
Var
  i: Integer;
Begin
  For i := 0 To Book.Count - 1 Do
    If SameText(Copy(Book.Names[i], 1, length(Name) + 1), Name + '@') Then exit(true);
  result := false;
End;

(* the section of [name] in the language Lang, [name] itself if there is none *)
Function LangSection(Index: Integer; Const Lang: String): Integer;
Begin
  result := Index;
  If (Lang <> '') And (Lang <> 'en') And (Book.IndexOf(Book.Names[Index] + '@' + Lang) >= 0) Then
    result := Book.IndexOf(Book.Names[Index] + '@' + Lang);
End;

Function VoiceLanguages: TStringArray;
Var
  i, k: Integer;
  lang: String;
  found: Boolean;
Begin
  result := Nil;
  setlength(result, 1);
  result[0] := 'en';
  For i := 0 To Book.Count - 1 Do
    If IsVariant(Book.Names[i]) Then Begin
      lang := LowerCase(Copy(Book.Names[i], Pos('@', Book.Names[i]) + 1, MaxInt));
      found := false;
      For k := 0 To high(result) Do
        If result[k] = lang Then found := true;
      If Not found Then Begin
        setlength(result, length(result) + 1);
        result[high(result)] := lang;
      End;
    End;
End;

Function IsVoiceLanguage(Const Lang: String): Boolean;
Var
  l: TStringArray;
  i: Integer;
Begin
  l := VoiceLanguages;
  For i := 0 To high(l) Do
    If SameText(l[i], Lang) Then exit(true);
  result := false;
End;

Function SoundGroup(Const RelPath: String): TAGSoundGroup;
Var
  n: String;

  Function Starts(Const Prefix: String): Boolean;
  Begin
    result := Copy(n, 1, length(Prefix)) = Prefix;
  End;

Var
  i: Integer;
Begin
  n := LowerCase(ChangeFileExt(ExtractFileName(RelPath), ''));
  For i := 0 To Music.FileCount - 1 Do
    If SameText(Music.Files[i].Name, n) Then exit(sgMusic);
  If IsSpoken(n) Then exit(sgVoice);
  If Starts('bomb_') Or Starts('expl') Then result := sgExplosion
  Else If Starts('kbomb') Or Starts('kicker') Or Starts('bmdrop') Or Starts('bmbthrw') Or Starts('bmbstop')
    Or Starts('bombstop') Or Starts('bombboun') Or Starts('grab') Or (n = '1017') Or (n = '1036') Or (n = '1045')
    Or (n = 'trampo') Then result := sgBomb
  Else If Starts('get') Or Starts('disease') Or (n = 'coolpop') Or (n = 'schwing') Then result := sgPowerup
  Else If Starts('sqrdrop') Or (n = 'clikplat') Then result := sgHurry
  Else If n = '1000' Then result := sgWinner
  Else If n = 'menuexit' Then result := sgMenu
  Else result := sgFigure; // die, scream, warp, trans*, zen
End;

(* plain files + one file per language for every spoken sound + music *)
Function ExpectedSounds(Ctx: TAGContext): Integer;
Var
  i, langs: Integer;
Begin
  result := Music.FileCount;
  langs := length(VoiceLanguages);
  For i := 0 To Book.Count - 1 Do
    If Not IsVariant(Book.Names[i]) Then Begin
      inc(result);
      If IsSpoken(Book.Names[i]) Then inc(result, langs);
    End;
End;

(* the expensive rendering only if the files are written or kept *)
Function Render(Output: TAGOutput): Boolean;
Begin
  result := (Not Output.DryRun) Or Output.KeepData;
End;

Procedure GenerateMusic(Ctx: TAGContext; Output: TAGOutput);
Var
  area: TAGArea;
  v: TAGMusicVariation;
  i, k: Integer;
  keys: TStringList;
  data: Array Of TBytes;
  f: TAGMusicFile;
  cacheKey: String;
Begin
  area := Ctx.Area('music');
  v := AGNeutralMusicVariation(DeriveSeed(area.Seed, 'noise'));
  v.Sound.Kit := StyleKit[Ctx.Style];
  v.Transpose := area.Pick('transpose', 5) - 2;
  v.Tempo := area.Vary('tempo', 1, 0.04);
  v.Sound.Bright := area.Vary('bright', 1, 0.2);
  v.Duty := area.Vary('duty', 1, 0.15);
  keys := TStringList.Create;
  Try
    data := Nil;
    For i := 0 To Music.FileCount - 1 Do Begin
      If Not Render(Output) Then Begin
        Output.SaveData('res/' + Music.Files[i].Name + '.wav', Nil);
        Continue;
      End;
      f := Music.Files[i];
      cacheKey := LowerCase(f.Song + '|' + f.Order + '|' + FloatToStr(f.Tempo) + '|' + IntToStr(f.Key));
      k := keys.IndexOf(cacheKey);
      If k < 0 Then Begin
        k := keys.Add(cacheKey);
        setlength(data, k + 1);
        data[k] := Music.RenderWav(i, v);
      End;
      Output.SaveData('res/' + Music.Files[i].Name + '.wav', data[k]);
    End;
  Finally
    keys.Free;
  End;
End;

Procedure GenerateSoundEffects(Ctx: TAGContext; Output: TAGOutput);
Var
  area: TAGArea;
  setPitch, setDecay, setBright, setNoise: Double;
  v: TAGSoundVariation;
  i, l: Integer;
  name, lang: String;
  langs: TStringArray;
  spoken, preview: Boolean;
  plain: TBytes;
Begin
  area := Ctx.Area('sounds');
  setPitch := area.Vary('pitch', 1, 0.06);
  setDecay := area.Vary('decay', 1, 0.15);
  setBright := area.Vary('bright', 1, 0.25);
  setNoise := area.Vary('noise', 0.8, 0.2); // rate of the noise, 0.6 = dull, 1 = white
  lang := LowerCase(Ctx.Language);
  langs := VoiceLanguages;
  preview := Output.DryRun And Output.KeepData; // the editor: only the plain files (Ctx.Language)
  For i := 0 To Book.Count - 1 Do Begin
    name := Book.Names[i];
    If IsVariant(name) Then Continue;
    spoken := IsSpoken(name);
    If Not Render(Output) Then Begin // previews: nothing to show, only count
      Output.SaveData(SoundPath(name), Nil);
      If spoken Then
        For l := 0 To high(langs) Do Output.SaveData(LangSoundPath(name, langs[l]), Nil);
      Continue;
    End;
    // per sound: pitch +-1.5 %, decay +-4 % on top of the set values (the same for every language)
    v := AGNeutralVariation(DeriveSeed(area.Seed, 'noise/' + name));
    v.Kit := StyleKit[Ctx.Style];
    v.Pitch := setPitch * (1 + 0.015 * (2 * area.Rnd('pitch/' + name) - 1));
    v.Decay := setDecay * (1 + 0.04 * (2 * area.Rnd('decay/' + name) - 1));
    v.Bright := setBright;
    v.NoiseRate := setNoise;
    // spoken sounds: the plain file in the language of the set, the section of the language, if there is one
    plain := AGRenderWav(Book.Parts[LangSection(i, lang)], v);
    Output.SaveData(SoundPath(name), plain);
    If spoken And Not preview Then
      For l := 0 To high(langs) Do
        If LangSection(i, langs[l]) = LangSection(i, lang) Then
          Output.SaveData(LangSoundPath(name, langs[l]), plain) // the same section: the same file
        Else
          Output.SaveData(LangSoundPath(name, langs[l]), AGRenderWav(Book.Parts[LangSection(i, langs[l])], v));
  End;
End;

Procedure GenerateSounds(Ctx: TAGContext; Output: TAGOutput);
Begin
  GenerateSoundEffects(Ctx, Output);
  GenerateMusic(Ctx, Output);
End;

Initialization
  Book := TAGSoundBook.Create;
  Book.LoadFromLines(SoundsIni);
  If Book.Errors.Count > 0 Then
    Raise Exception.Create('uag_sounds_ini.inc: line not understood: ' + Book.Errors[0]);
  Music := TAGMusicBook.Create;
  Music.LoadFromLines(MusicIni);
  If Music.Errors.Count > 0 Then
    Raise Exception.Create('uag_music_ini.inc: ' + Music.Errors[0]);
  RegisterGenerator('sounds', 'Sound effects and menu music (sounds/*.wav, res/*.wav)', @ExpectedSounds, @GenerateSounds);

Finalization
  Book.Free;
  Music.Free;

End.
