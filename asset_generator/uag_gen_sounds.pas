(*
 * Generator 'sounds': renders every section of sounds.ini (own synth
 * interpretations of the game sounds, see uag_sound) into
 * sounds/<name>.wav, the menu sounds into res/<name>.wav, and the menu music
 * of music.ini (res/mainmenu_sound.wav, join_sound.wav,
 * player_setup_sound.wav, draw.wav). The file names are the ones of the
 * original game, so the client needs no mapping.
 *
 * sounds.ini and music.ini are compiled in (uag_sounds_ini.inc,
 * uag_music_ini.inc, generated by tools/wav2ini --inc), so the generator
 * works without any data files.
 *
 * The style chooses the sound kit (flat, soft, pixel, retro, see uag_sound).
 * Every set gets its own variant on top: pitch, decay, brightness and noise
 * colour of the whole set and a little per sound, its own noise; the music
 * is transposed (+-2 semitones), a bit faster or slower and its pulse widths
 * differ. Music files with the same song and changes are rendered once.
 *)
Unit uag_gen_sounds;

{$MODE ObjFPC}{$H+}

Interface

Implementation

Uses Classes, SysUtils, uag_context, uag_output, uag_registry, uag_random, uag_sound;

Const
{$I uag_sounds_ini.inc}
{$I uag_music_ini.inc}

  ResSounds: Array[0..1] Of String = ('menuexit', 'quitgame'); // go to res/, all others to sounds/
  StyleKit: Array[TAGStyle] Of TAGSoundKit = (skFlat, skSoft, skPixel, skRetro);

Var
  Book: TAGSoundBook = Nil;
  Music: TAGMusicBook = Nil;

Function SoundPath(Const Name: String): String;
Var
  i: Integer;
Begin
  For i := 0 To high(ResSounds) Do
    If SameText(ResSounds[i], Name) Then exit('res/' + Name + '.wav');
  result := 'sounds/' + Name + '.wav';
End;

Function ExpectedSounds(Ctx: TAGContext): Integer;
Begin
  result := Book.Count + Music.FileCount;
End;

Procedure GenerateMusic(Ctx: TAGContext; Output: TAGOutput);
Var
  area: TAGArea;
  v: TAGMusicVariation;
  i, k: Integer;
  keys: TStringList;
  data: Array Of TBytes;
  f: TAGMusicFile;
  cacheKey: String;
Begin
  area := Ctx.Area('music');
  v := AGNeutralMusicVariation(DeriveSeed(area.Seed, 'noise'));
  v.Sound.Kit := StyleKit[Ctx.Style];
  v.Transpose := area.Pick('transpose', 5) - 2;
  v.Tempo := area.Vary('tempo', 1, 0.04);
  v.Sound.Bright := area.Vary('bright', 1, 0.2);
  v.Duty := area.Vary('duty', 1, 0.15);
  keys := TStringList.Create;
  Try
    data := Nil;
    For i := 0 To Music.FileCount - 1 Do Begin
      If Output.DryRun Then Begin
        Output.SaveData('res/' + Music.Files[i].Name + '.wav', Nil);
        Continue;
      End;
      f := Music.Files[i];
      cacheKey := LowerCase(f.Song + '|' + f.Order + '|' + FloatToStr(f.Tempo) + '|' + IntToStr(f.Key));
      k := keys.IndexOf(cacheKey);
      If k < 0 Then Begin
        k := keys.Add(cacheKey);
        setlength(data, k + 1);
        data[k] := Music.RenderWav(i, v);
      End;
      Output.SaveData('res/' + Music.Files[i].Name + '.wav', data[k]);
    End;
  Finally
    keys.Free;
  End;
End;

Procedure GenerateSounds(Ctx: TAGContext; Output: TAGOutput);
Var
  area: TAGArea;
  setPitch, setDecay, setBright, setNoise: Double;
  v: TAGSoundVariation;
  i: Integer;
  name: String;
Begin
  area := Ctx.Area('sounds');
  setPitch := area.Vary('pitch', 1, 0.06);
  setDecay := area.Vary('decay', 1, 0.15);
  setBright := area.Vary('bright', 1, 0.25);
  setNoise := area.Vary('noise', 0.8, 0.2); // rate of the noise, 0.6 = dull, 1 = white
  For i := 0 To Book.Count - 1 Do Begin
    name := Book.Names[i];
    If Output.DryRun Then Begin // previews: nothing to show, only count
      Output.SaveData(SoundPath(name), Nil);
      Continue;
    End;
    // per sound: pitch +-1.5 %, decay +-4 % on top of the set values
    v := AGNeutralVariation(DeriveSeed(area.Seed, 'noise/' + name));
    v.Kit := StyleKit[Ctx.Style];
    v.Pitch := setPitch * (1 + 0.015 * (2 * area.Rnd('pitch/' + name) - 1));
    v.Decay := setDecay * (1 + 0.04 * (2 * area.Rnd('decay/' + name) - 1));
    v.Bright := setBright;
    v.NoiseRate := setNoise;
    Output.SaveData(SoundPath(name), AGRenderWav(Book.Parts[i], v));
  End;
  GenerateMusic(Ctx, Output);
End;

Initialization
  Book := TAGSoundBook.Create;
  Book.LoadFromLines(SoundsIni);
  If Book.Errors.Count > 0 Then
    Raise Exception.Create('uag_sounds_ini.inc: line not understood: ' + Book.Errors[0]);
  Music := TAGMusicBook.Create;
  Music.LoadFromLines(MusicIni);
  If Music.Errors.Count > 0 Then
    Raise Exception.Create('uag_music_ini.inc: ' + Music.Errors[0]);
  RegisterGenerator('sounds', 'Sound effects and menu music (sounds/*.wav, res/*.wav)', @ExpectedSounds, @GenerateSounds);

Finalization
  Book.Free;
  Music.Free;

End.
