  object CheckListBox1: TCheckListBox
    Hint = 'Check a mod to switch it on, click its name to see its settings.'
    Left = 8
    Height = 316
    Top = 8
    Width = 160
    Items.Strings = (
      'Stun on bomb landing'
      'Positive disease'
      'Hit points'
      'Ghosts'
      'Mod test mode'
    )
    ItemHeight = 0
    OnClickCheck = CheckListBox1ClickCheck
    OnSelectionChange = CheckListBox1SelectionChange
  end
  object PageControl1: TPageControl
