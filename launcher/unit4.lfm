        end
        object Label12: TLabel
          Left = 8
          Height = 16
          Top = 210
          Width = 312
          AutoSize = False
          Caption = 'Name~2 = second player on the same PC.'
          WordWrap = True
        end
      end
    end
    object TabSheet4: TTabSheet
      Caption = 'TabSheet4'
      object CheckBox4: TCheckBox
        Left = 8
        Height = 19
        Top = 8
        Caption = 'Ghosts'
        Font.Style = [fsBold]
        ParentFont = False
        OnChange = CheckBox1Change
      end
      object Label13: TLabel
        Left = 8
        Height = 32
        Top = 34
        Width = 312
        AutoSize = False
        Caption = 'Dead players walk around the field as ghosts until hurry. A ghost bomb that kills an opponent brings the ghost back.'
        WordWrap = True
      end
      object Panel4: TPanel
        Left = 0
        Height = 236
        Top = 72
        Width = 328
        BevelOuter = bvNone
        ParentColor = True
        object Label14: TLabel
          Left = 8
          Height = 15
          Top = 12
          Caption = 'Flame length of the ghost bomb'
        end
        object SpinEdit8: TSpinEdit
          Hint = 'Flame length of the bomb a ghost throws.'
          Left = 220
          Height = 23
          Top = 8
          Width = 96
          Increment = 1
        end
        object Label15: TLabel
          Left = 8
          Height = 15
          Top = 42
          Caption = 'Invulnerable after return (ms)'
        end
        object SpinEdit9: TSpinEdit
          Hint = 'A ghost that comes back is invulnerable for this time.'
          Left = 220
          Height = 23
          Top = 38
          Width = 96
          Increment = 500
        end
        object Label16: TLabel
          Left = 8
          Height = 15
          Top = 72
          Caption = 'Max. times ghost per round'
        end
        object SpinEdit10: TSpinEdit
          Hint = 'How often a player can become a ghost per round, 0 = unlimited.'
          Left = 220
          Height = 23
          Top = 68
          Width = 96
          Increment = 1
        end
        object Label17: TLabel
          Left = 8
          Height = 15
          Top = 102
          Caption = 'Max. time as ghost (ms)'
        end
        object SpinEdit11: TSpinEdit
          Hint = 'A ghost that hits no opponent within this time vanishes, 0 = unlimited.'
          Left = 220
          Height = 23
          Top = 98
          Width = 96
          Increment = 1000
        end
        object Label18: TLabel
          Left = 8
          Height = 15
          Top = 132
          Caption = 'Flicker time (ms)'
        end
        object SpinEdit12: TSpinEdit
          Hint = 'Ghosts are visible for 3 ticks and invisible for 1 tick, this is the length of a tick. 0 = no flicker.'
          Left = 220
          Height = 23
          Top = 128
          Width = 96
          Increment = 50
        end
        object Label19: TLabel
          Left = 8
          Height = 32
          Top = 162
          Width = 312
          AutoSize = False
          Caption = '0 = unlimited, flicker time 0 = no flicker. In the last 5 s before a ghost vanishes it flickers faster.'
          WordWrap = True
        end
      end
    end
    object TabSheet5: TTabSheet
      Caption = 'TabSheet5'
      object CheckBox5: TCheckBox
        Left = 8
        Height = 19
        Top = 8
        Caption = 'Mod test mode'
        Font.Style = [fsBold]
        ParentFont = False
        OnChange = CheckBox1Change
      end
      object Label20: TLabel
        Left = 8
        Height = 32
        Top = 34
        Width = 312
        AutoSize = False
        Caption = 'Only for testing, shows a hint to all players. In game F3 shows the test keys (only for the master).'
        WordWrap = True
        Font.Color = clRed
        ParentFont = False
      end
      object Panel5: TPanel
        Left = 0
        Height = 236
        Top = 72
        Width = 328
        BevelOuter = bvNone
        ParentColor = True
        object Label21: TLabel
          Left = 8
          Height = 15
          Top = 12
          Caption = 'Start items'
        end
        object Edit1: TEdit
          Hint = 'Items every player gets at round start, comma separated, *n = n times. Possible: bomb, flame, goldflame, speed, kick, punch, grab, spooger, jelly, trigger.'
          Left = 120
          Height = 23
          Top = 8
          Width = 196
        end
        object Label22: TLabel
          Left = 120
          Height = 15
          Top = 34
          Caption = 'e.g. kick,punch,grab,bomb*3'
        end
        object Label23: TLabel
          Left = 8
          Height = 15
          Top = 72
          Caption = 'Round time (s, 0 = normal)'
        end
        object SpinEdit13: TSpinEdit
          Hint = 'Round time in seconds, hurry starts at 80 s remaining. 0 = time from the game settings.'
          Left = 220
          Height = 23
          Top = 68
          Width = 96
          Increment = 10
        end
        object Label24: TLabel
          Left = 8
          Height = 15
          Top = 102
          Caption = 'Invulnerable at start (ms)'
        end
        object SpinEdit14: TSpinEdit
          Hint = 'All players are invulnerable for this time at round start.'
          Left = 220
          Height = 23
          Top = 98
          Width = 96
          Increment = 1000
        end
        object CheckBox7: TCheckBox
          Hint = 'Ghosts count as alive, so the round does not end when only one player is left. Allows testing ghosts with 2 players.'
          Left = 8
          Height = 19
          Top = 130
          Caption = 'Ghosts count as alive (test ghosts with 2 players)'
        end
      end
    end
  end
  object Label25: TLabel
    Left = 8
    Height = 15
