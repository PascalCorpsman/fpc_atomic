      end
      object Label4: TLabel
        Left = 8
        Height = 32
        Top = 34
        Width = 312
        AutoSize = False
        Caption = 'Some disease items make the player invulnerable for a random time instead of sick (not during hurry).'
        WordWrap = True
      end
      object Panel2: TPanel
        Left = 0
        Height = 236
        Top = 72
        Width = 328
        BevelOuter = bvNone
        ParentColor = True
        object Label5: TLabel
          Left = 8
          Height = 15
          Top = 12
          Caption = 'Chance of a disease item (%)'
        end
        object SpinEdit3: TSpinEdit
          Hint = 'Share of the disease items that make the player invulnerable instead of sick.'
          Left = 220
          Height = 23
          Top = 8
          Width = 96
          Increment = 5
        end
        object Label6: TLabel
          Left = 8
          Height = 15
          Top = 42
          Caption = 'Min. invulnerable time (ms)'
        end
