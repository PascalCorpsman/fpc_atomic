    object TabSheet1: TTabSheet
      Caption = 'TabSheet1'
      object CheckBox1: TCheckBox
        Left = 8
        Height = 19
        Top = 8
        Caption = 'Stun on bomb landing'
        Font.Style = [fsBold]
