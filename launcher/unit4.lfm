    object TabSheet3: TTabSheet
      Caption = 'TabSheet3'
      object CheckBox3: TCheckBox
        Left = 8
        Height = 19
        Top = 8
        Caption = 'Hit points'
        Font.Style = [fsBold]
        ParentFont = False
        OnChange = CheckBox1Change
      end
      object Label8: TLabel
        Left = 8
        Height = 32
        Top = 34
        Width = 312
        AutoSize = False
        Caption = 'Players survive several hits, set per player name. During hurry every hit is lethal.'
        WordWrap = True
      end
      object Panel3: TPanel
        Left = 0
        Height = 236
        Top = 72
        Width = 328
        BevelOuter = bvNone
        ParentColor = True
        object Label9: TLabel
          Left = 8
          Height = 15
          Top = 12
          Caption = 'Invulnerable after a hit (ms)'
        end
        object SpinEdit6: TSpinEdit
          Hint = 'After a hit that is not lethal the player is invulnerable for this time, so the same flame does not hit twice.'
          Left = 220
          Height = 23
          Top = 8
          Width = 96
          Increment = 500
        end
        object Label10: TLabel
          Left = 8
          Height = 15
          Top = 42
          Caption = 'Default hit points'
        end
        object SpinEdit7: TSpinEdit
          Hint = 'Hit points of all players that are not in the handicap table.'
          Left = 220
          Height = 23
          Top = 38
          Width = 96
          Increment = 1
        end
        object CheckBox6: TCheckBox
          Hint = 'Show the remaining hit points above each player (only if more than 1).'
          Left = 8
          Height = 19
          Top = 70
          Caption = 'Show hit points above the players'
        end
        object Label11: TLabel
          Left = 8
          Height = 15
          Top = 100
          Caption = 'Handicap per player:'
        end
        object StringGrid1: TStringGrid
          Hint = 'Hit points per player name, e.g. more for weaker players. Name~2 is the second player on the same PC.'
          Left = 8
          Height = 88
          Top = 118
          Width = 270
          ColCount = 2
          DefaultRowHeight = 20
          FixedCols = 0
          RowCount = 1
          Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goEditing, goSmoothScroll]
          ColWidths = (
            180
            86
          )
          OnPrepareCanvas = StringGrid1PrepareCanvas
        end
        object Button4: TButton
          Hint = 'Add a line.'
          Left = 288
          Height = 25
          Top = 118
          Width = 28
          Caption = '+'
          OnClick = Button4Click
        end
        object Button5: TButton
          Hint = 'Delete the selected line.'
          Left = 288
          Height = 25
          Top = 148
          Width = 28
          Caption = '-'
