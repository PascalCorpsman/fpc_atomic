      end
      object Label1: TLabel
        Left = 8
        Height = 32
        Top = 34
        Width = 312
        AutoSize = False
        Caption = 'A bomb thrown with the glove that lands on a player stuns the player for a random time between min. and max.'
        WordWrap = True
      end
      object Panel1: TPanel
        Left = 0
        Height = 236
        Top = 72
        Width = 328
        BevelOuter = bvNone
        ParentColor = True
        object Label2: TLabel
          Left = 8
          Height = 15
          Top = 12
          Caption = 'Min. stun time (ms)'
        end
        object SpinEdit1: TSpinEdit
          Hint = 'Shortest stun time. The stun time is random between min. and max.'
          Left = 220
          Height = 23
          Top = 8
          Width = 96
          Increment = 50
        end
        object Label3: TLabel
          Left = 8
          Height = 15
          Top = 42
          Caption = 'Max. stun time (ms)'
        end
        object SpinEdit2: TSpinEdit
          Hint = 'Longest stun time. The stun time is random between min. and max.'
          Left = 220
          Height = 23
          Top = 38
          Width = 96
          Increment = 50
        end
      end
    end
    object TabSheet2: TTabSheet
      Caption = 'TabSheet2'
