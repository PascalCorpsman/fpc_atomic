    Hint = 'TCP port of the server when hosting a game (default 5521).'
    Left = 230
    Height = 23
    Top = 306
    Width = 100
    Increment = 1
    MaxValue = 65535
    MinValue = 1
  end
  object Label6: TLabel
    Left = 12
    Height = 15
    Top = 342
    Caption = 'Volume (%)'
  end
