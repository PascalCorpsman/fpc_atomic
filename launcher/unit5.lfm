object Form5: TForm5
  Left = 400
  Height = 445
  Top = 150
  Width = 768
  BorderStyle = bsDialog
  Caption = 'Form5'
  ClientHeight = 445
  ClientWidth = 768
  Position = poMainFormCenter
  ShowHint = True
  LCLVersion = '4.8.0.0'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  object CheckBox1: TCheckBox
    Hint = 'Players play in two teams (red and white).'
    Left = 12
    Height = 19
    Top = 12
    Caption = 'Team play'
  end
  object CheckBox2: TCheckBox
    Hint = 'Players start at random start positions of the scheme.'
    Left = 12
    Height = 19
    Top = 38
    Caption = 'Random start positions'
  end
  object CheckBox3: TCheckBox
    Hint = 'If a network player loses the connection, an AI takes over.'
    Left = 12
    Height = 19
    Top = 64
    Caption = 'Lost net players revert to AI'
  end
  object CheckBox4: TCheckBox
    Hint = 'Play the sound effects (explosions, items, ...). The music is switched with "Play music" in the launcher.'
    Left = 12
    Height = 19
    Top = 90
    Caption = 'Play sound effects'
  end
  object Label1: TLabel
    Left = 12
    Height = 15
    Top = 124
    Caption = 'Scheme'
  end
  object ComboBox2: TComboBox
    Hint = 'The scheme sets the bricks, the start positions and the items (files in data/schemes).'
    Left = 230
    Height = 23
    Top = 120
    Width = 190
    ItemHeight = 15
    Style = csDropDownList
    OnChange = ComboBox2Change
  end
  object Label8: TLabel
    Left = 12
    Height = 15
    Top = 156
    Caption = 'Map'
  end
  object ComboBox4: TComboBox
    Hint = 'The map of the next game when hosting (files in data/maps).'
    Left = 230
    Height = 23
    Top = 152
    Width = 190
    ItemHeight = 15
    Style = csDropDownList
    OnChange = ComboBox2Change
  end
  object Image1: TImage
    Hint = 'The map with all bricks of the scheme. In the game some bricks are missing at random, depending on the brick density of the scheme.'
    Left = 436
    Height = 240
    Top = 12
    Width = 320
  end
  object Label2: TLabel
    Left = 12
    Height = 15
    Top = 188
    Caption = 'Play time'
  end
  object ComboBox3: TComboBox
    Hint = 'Time of a round. The hurry starts 80 s before the end. Infinity = no time limit and no hurry.'
    Left = 230
    Height = 23
    Top = 184
    Width = 100
    ItemHeight = 15
    Style = csDropDownList
  end
  object Label3: TLabel
    Left = 12
    Height = 15
    Top = 220
    Caption = 'Wins to win the match'
  end
  object SpinEdit2: TSpinEdit
    Hint = 'How many rounds a player or team has to win to win the match.'
    Left = 230
    Height = 23
    Top = 216
    Width = 100
    Increment = 1
    MaxValue = 99
    MinValue = 1
  end
  object Label4: TLabel
    Left = 12
    Height = 15
    Top = 252
    Caption = 'Conveyor speed'
  end
  object ComboBox1: TComboBox
    Hint = 'Speed of the conveyor belts on maps that have them.'
    Left = 230
    Height = 23
    Top = 248
    Width = 100
    ItemHeight = 15
    Style = csDropDownList
    Items.Strings = (
      'Slow'
      'Middle'
      'Fast'
    )
  end
  object Label5: TLabel
    Left = 12
    Height = 15
    Top = 284
    Caption = 'Network port'
  end
  object SpinEdit1: TSpinEdit
    Hint = 'TCP port of the server when hosting a game (default 5521).'
    Left = 230
    Height = 23
    Top = 280
    Width = 100
    Increment = 1
    MaxValue = 65535
    MinValue = 1
  end
  object Label6: TLabel
    Left = 12
    Height = 15
    Top = 316
    Caption = 'Volume (%)'
  end
  object SpinEdit3: TSpinEdit
    Hint = 'Sound volume, in the game it can also be changed with + and -.'
    Left = 230
    Height = 23
    Top = 312
    Width = 100
    Increment = 5
    MaxValue = 100
    MinValue = 0
  end
  object Label7: TLabel
    Left = 12
    Height = 52
    Top = 346
    Width = 408
    AutoSize = False
    Caption = 'The same settings as in the options of the game. Field and wins can also be changed in the game when hosting.'
    WordWrap = True
  end
  object Button1: TButton
    Hint = 'Reset the settings to the defaults of the game. Saved only with OK.'
    Left = 12
    Height = 25
    Top = 408
    Width = 100
    Caption = '&Defaults'
    OnClick = Button1Click
  end
  object Button2: TButton
    Hint = 'Save the settings, they apply to the next start of the game.'
    Left = 576
    Height = 25
    Top = 408
    Width = 85
    Caption = 'OK'
    Default = True
    ModalResult = 1
  end
  object Button3: TButton
    Hint = 'Close without saving.'
    Left = 671
    Height = 25
    Top = 408
    Width = 85
    Cancel = True
    Caption = 'Cancel'
    ModalResult = 2
  end
end
