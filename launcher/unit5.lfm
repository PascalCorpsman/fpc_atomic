object Form5: TForm5
  Left = 400
  Height = 471
  Top = 150
  Width = 768
  BorderStyle = bsDialog
  Caption = 'Form5'
  ClientHeight = 471
  ClientWidth = 768
  Position = poMainFormCenter
  ShowHint = True
  LCLVersion = '4.8.0.0'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnShow = FormShow
  object CheckBox1: TCheckBox
    Hint = 'Players play in two teams (red and white).'
    Left = 12
    Height = 19
    Top = 12
    Caption = 'Team play'
  end
  object CheckBox2: TCheckBox
    Hint = 'Players start at random start positions of the scheme.'
    Left = 12
    Height = 19
    Top = 38
    Caption = 'Random start positions'
  end
  object CheckBox3: TCheckBox
    Hint = 'If a network player loses the connection, an AI takes over.'
    Left = 12
    Height = 19
    Top = 64
    Caption = 'Lost net players revert to AI'
  end
  object CheckBox4: TCheckBox
    Hint = 'Play the sound effects (explosions, items, ...), the same as "Play sounds" in the launcher. The music is switched with "Play music" in the launcher.'
    Left = 12
    Height = 19
    Top = 90
    Caption = 'Play sound effects'
  end
  object CheckBox5: TCheckBox
    Hint = 'After a finished match the launcher opens the statistics of that server. Only if the launcher is shown again after the game.'
    Left = 12
    Height = 19
    Top = 116
    Caption = 'Show statistics after the game'
  end
  object Label1: TLabel
    Left = 12
    Height = 15
    Top = 150
    Caption = 'Scheme'
  end
  object ComboBox2: TComboBox
    Hint = 'The scheme sets the bricks, the start positions and the items (files in data/schemes).'
    Left = 230
    Height = 23
    Top = 146
    Width = 190
    ItemHeight = 15
    Style = csDropDownList
    OnChange = ComboBox2Change
  end
  object Label8: TLabel
    Left = 12
    Height = 15
    Top = 182
    Caption = 'Map'
  end
  object ComboBox4: TComboBox
    Hint = 'The map of the next game when hosting (files in data/maps).'
    Left = 230
    Height = 23
    Top = 178
    Width = 190
    ItemHeight = 15
    Style = csDropDownList
    OnChange = ComboBox2Change
  end
  object Image1: TImage
    Hint = 'The map with all bricks of the scheme. In the game some bricks are missing at random, depending on the brick density of the scheme.'
    Left = 436
    Height = 240
    Top = 12
    Width = 320
  end
  object Label10: TLabel
    AnchorSideTop.Control = ComboBox5
    AnchorSideTop.Side = asrCenter
    Left = 436
    Height = 15
    Top = 294
    Caption = 'Graphics set'
    FocusControl = ComboBox5
  end
  object ComboBox5: TComboBox
    AnchorSideTop.Control = Image1
    AnchorSideTop.Side = asrBottom
    Hint = 'The graphics of the game: Original (from the CD) or a set from the graphics generator (folders in assets). Missing graphics of a set are taken from the original.'
    Left = 540
    Height = 23
    Top = 290
    Width = 216
    BorderSpacing.Top = 12
    ItemHeight = 15
    Style = csDropDownList
    OnChange = ComboBox2Change
  end
  object Label11: TLabel
    AnchorSideTop.Control = ComboBox6
    AnchorSideTop.Side = asrCenter
    Left = 436
    Height = 15
    Top = 326
    Caption = 'Sounds'
    FocusControl = ComboBox6
  end
  object ComboBox6: TComboBox
    AnchorSideTop.Control = ComboBox5
    AnchorSideTop.Side = asrBottom
    Hint = 'The sounds of the game.'#13#10'Automatic: the sounds of the selected graphics set'#13#10'(with "Original" the sounds from the CD).'#13#10'Original (CD): always the sounds from the CD.'#13#10'Or the sounds of a set from the graphics generator.'#13#10'Missing sounds of a set are taken from the original.'
    Left = 540
    Height = 23
    Top = 322
    Width = 216
    BorderSpacing.Top = 9
    ItemHeight = 15
    Style = csDropDownList
  end
  object Label12: TLabel
    AnchorSideTop.Control = ComboBox7
    AnchorSideTop.Side = asrCenter
    Left = 436
    Height = 15
    Top = 358
    Caption = 'AI'
    FocusControl = ComboBox7
  end
  object ComboBox7: TComboBox
    AnchorSideTop.Control = ComboBox6
    AnchorSideTop.Side = asrBottom
    Hint = 'The ai of the computer players when you host a game.'#13#10'Original: the ai of FPC Atomic.'#13#10'Smart: plays smarter, its strength is set with the difficulty.'
    Left = 540
    Height = 23
    Top = 354
    Width = 216
    BorderSpacing.Top = 9
    ItemHeight = 15
    Style = csDropDownList
    OnChange = ComboBox7Change
  end
  object Label13: TLabel
    AnchorSideTop.Control = SpinEdit4
    AnchorSideTop.Side = asrCenter
    Left = 436
    Height = 15
    Top = 390
    Caption = 'Difficulty'
    FocusControl = SpinEdit4
  end
  object SpinEdit4: TSpinEdit
    AnchorSideTop.Control = ComboBox7
    AnchorSideTop.Side = asrBottom
    Hint = 'Strength of the smart ai: 0 = easy, 50 = normal, 100 = strong.'#13#10'More settings are in ai_smart.ini, see the manual of the smart ai.'
    Left = 540
    Height = 23
    Top = 386
    Width = 100
    BorderSpacing.Top = 9
    Increment = 5
    MaxValue = 100
    Value = 50
  end
  object Label2: TLabel
    Left = 12
    Height = 15
    Top = 214
    Caption = 'Play time'
  end
  object ComboBox3: TComboBox
    Hint = 'Time of a round. The hurry starts 80 s before the end. Infinity = no time limit and no hurry.'
    Left = 230
    Height = 23
    Top = 210
    Width = 100
    ItemHeight = 15
    Style = csDropDownList
  end
  object Label3: TLabel
    Left = 12
    Height = 15
    Top = 246
    Caption = 'Wins to win the match'
  end
  object SpinEdit2: TSpinEdit
    Hint = 'How many rounds a player or team has to win to win the match.'
    Left = 230
    Height = 23
    Top = 242
    Width = 100
    Increment = 1
    MaxValue = 99
    MinValue = 1
  end
  object Label4: TLabel
    Left = 12
    Height = 15
    Top = 278
    Caption = 'Conveyor speed'
  end
  object ComboBox1: TComboBox
    Hint = 'Speed of the conveyor belts on maps that have them.'
    Left = 230
    Height = 23
    Top = 274
    Width = 100
    ItemHeight = 15
    Style = csDropDownList
    Items.Strings = (
      'Slow'
      'Middle'
      'Fast'
    )
  end
  object Label5: TLabel
    Left = 12
    Height = 15
    Top = 310
    Caption = 'Network port'
  end
