    Hint = 'Sound volume, in the game it can also be changed with + and -.'
    Left = 230
    Height = 23
    Top = 338
    Width = 100
    Increment = 5
    MaxValue = 100
    MinValue = 0
  end
  object Label7: TLabel
    Left = 12
    Height = 52
    Top = 372
    Width = 408
    AutoSize = False
    Caption = 'The same settings as in the options of the game. Field and wins can also be changed in the game when hosting.'
    WordWrap = True
  end
  object Label9: TLabel
    Cursor = crHandPoint
    Left = 124
    Height = 15
    Hint = 'Open the manual of the game options and game modes (GAMEOPTIONS_MANUAL.md, with a link to the German version).'
    Top = 439
    Caption = 'Manual'
    Font.Color = clBlue
    Font.Style = [fsUnderline]
    ParentFont = False
    OnClick = Label9Click
  end
  object Button1: TButton
    Hint = 'Reset the settings to the defaults of the game. Saved only with OK.'
    Left = 12
    Height = 25
    Top = 434
    Width = 100
    Caption = '&Defaults'
    OnClick = Button1Click
  end
  object Button2: TButton
    Hint = 'Save the settings, they apply to the next start of the game.'
    Left = 576
    Height = 25
    Top = 434
    Width = 85
    Caption = 'OK'
    Default = True
    ModalResult = 1
  end
  object Button3: TButton
    Hint = 'Close without saving.'
    Left = 671
    Height = 25
    Top = 434
    Width = 85
    Cancel = True
    Caption = 'Cancel'
    ModalResult = 2
  end
end
