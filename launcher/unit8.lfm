    ClientWidth = 820
    TabOrder = 0
    object Label1: TLabel
      Left = 12
      Height = 15
      Top = 14
      Caption = '&Server:'
      FocusControl = ComboBox1
    end
    object ComboBox1: TComboBox
      Hint = 'This computer: the games hosted here. Below: a copy of the statistics of every other server you played on, as of your last game there.'
      Left = 80
      Height = 23
      Top = 10
      Width = 420
      ItemHeight = 15
      Style = csDropDownList
      TabOrder = 0
      OnChange = ComboBox1Change
    end
    object Button1: TButton
      Hint = 'Delete the copy of the statistics of this server.'
      Left = 510
      Height = 25
      Top = 9
      Width = 90
      Caption = '&Remove'
      TabOrder = 1
      OnClick = Button1Click
    end
    object Button2: TButton
      Hint = 'Open the folder with the statistics files.'
      Left = 610
      Height = 25
      Top = 9
      Width = 110
      Caption = 'Open &folder'
      TabOrder = 2
      OnClick = Button2Click
    end
    object Label2: TLabel
      Left = 12
      Height = 15
      Top = 46
      Caption = '&Players:'
      FocusControl = ComboBox2
    end
    object ComboBox2: TComboBox
      Hint = 'Show all players, only humans or only the AI players.'
      Left = 80
      Height = 23
      Top = 42
      Width = 160
      ItemHeight = 15
      ItemIndex = 0
      Items.Strings = (
        'All players'
        'Without AI'
        'Only AI'
      )
      Style = csDropDownList
      TabOrder = 3
      Text = 'All players'
      OnChange = CheckBox1Change
    end
    object CheckBox1: TCheckBox
      Hint = 'Also show the columns about bombs, bricks, items and diseases.'
      Left = 260
      Height = 19
      Top = 44
      Caption = 'All &values'
      TabOrder = 4
      OnChange = CheckBox1Change
    end
    object CheckBox2: TCheckBox
      Hint = 'A player counts once for every key set (keyboard 1 / 2). Checked: the same name is one row.'
      Left = 380
      Height = 19
      Top = 44
      Caption = '&Merge key sets'
      Checked = True
      State = cbChecked
      TabOrder = 5
      OnChange = CheckBox1Change
    end
  end
