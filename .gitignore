# Source: https://github.com/github/gitignore/blob/main/Global/Lazarus.gitignore

# Lazarus compiler-generated binaries (safe to delete)
*.exe
*.dll
*.so
*.dylib
*.lrs
*.res
*.compiled
*.dbg
*.ppu
*.o
*.or
*.a

# Lazarus autogenerated files (duplicated info)
*.rst
*.rsj
*.lrt

# Lazarus local files (user-specific info)
*.lps

# Lazarus backups and unit output folders.
# These can be changed by user in Lazarus/project options.
backup/
*.bak
lib/
release/

# Application bundle for Mac OS
*.app/

# Atomic files
server/stats.txt
stats.txt


# Game data (copyrighted, comes from the original CD / extractor). Files already tracked stay tracked.
data/
data_*/

# Build output in repo root
/fpc_atomic
/atomic_server
/atomic_launcher
link*.res

# External dependency (own git clone), not part of this repo
client/sdl2/SDL2-for-Pascal/

# Local checkout of the own server repo
/fpcatomic/

# Logs / local config
*.log
fpc_atomic.ini
atomic_server.ini
